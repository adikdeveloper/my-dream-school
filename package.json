{
  "name": "my-dream-school",
  "version": "1.0.0",
  "description": "Modern School Management System with Brand Integration",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "start": "concurrently \"npm run backend:start\" \"npm run frontend:start\"",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "frontend:dev": "cd frontend && npm start",
    "frontend:start": "cd frontend && npm run build && serve -s build",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "build": "cd frontend && npm run build",
    "seed:demo": "cd backend && node seedDemoData.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "school",
    "management",
    "education",
    "react",
    "nodejs",
    "mongodb",
    "dashboard"
  ],
  "author": "My Dream School Development Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}